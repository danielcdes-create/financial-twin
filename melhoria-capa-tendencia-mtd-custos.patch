+  monthDashboard,
+  yearDashboard,
+  money: formatMoney,
+  onOpenCategory,
+}: {
+  dashboard: any;
+  monthDashboard: any;
+  yearDashboard: any;
+  money: (value: number) => string;
+  onOpenCategory: (category: string) => void;
