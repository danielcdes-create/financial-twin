XAI_TEXT_MODEL=grok-4.3
XAI_VISION_MODEL=grok-4.3
XAI_IMAGE_MODEL=grok-imagine-image
XAI_TRANSCRIPTION_MODEL=grok-voice-transcribe-2.0

# SECURITY
JWT_SECRET=
API_SECRET=

# OPEN FINANCE - FUTURE
OPEN_FINANCE_PROVIDER=
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=
APP_PASSWORD=
# Use an absolute path on a durable shared volume when running multiple API instances.
MEDIA_STORAGE_PATH=data/media



