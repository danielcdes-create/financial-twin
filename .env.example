# APPLICATION
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=

# MONGODB (target existing v1.2 database; no automatic migration)
MONGODB_URI=
MONGODB_DATABASE=financas
MONGODB_DIRECT_HOSTS=
MONGODB_REPLICA_SET=

# XAI: credentials stay on the server
XAI_API_KEY=
