{
  "version": "1.2.2",
  "validationLevel": "strict",
  "validationAction": "error",
  "collections": {
    "accounts": {
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "additionalProperties": false,
          "required": [
            "_id",
            "external_key",
            "schema_version",
            "instituicao",
            "tipo",
            "titular",
            "moeda",
            "status",
            "created_at",
            "updated_at"
          ],
          "properties": {
            "_id": {
              "bsonType": "objectId",
              "description": "Identificador MongoDB."
            },
            "external_key": {
              "bsonType": "string",
              "minLength": 1,
              "description": "Chave determinística para idempotência."
            },
            "schema_version": {
              "bsonType": "int",
              "minimum": 1,
              "description": "Versão do contrato."
            },
            "created_at": {
              "bsonType": "date",
              "description": "Data de criação técnica."
            },
            "updated_at": {
              "bsonType": "date",
              "description": "Última atualização técnica."
            },
            "instituicao": {
              "bsonType": "string",
              "minLength": 1,
              "description": "Instituição financeira normalizada."
            },
            "tipo": {
              "enum": [
                "conta_corrente",
                "cartao_credito",
                "investimento",
                "financiamento"
              ],
              "description": "Tipo da conta financeira."
            },
            "agencia": {
              "bsonType": "string",
              "minLength": 1
            },
            "conta": {
              "bsonType": "string",
              "minLength": 1
            },
            "cartao_final": {
              "bsonType": "string",
              "pattern": "^[0-9]{4}$"
            },
            "titular": {
              "bsonType": "string",
              "minLength": 1
            },
            "cpf_cnpj_titular": {
              "bsonType": "string",
              "pattern": "^(?:[0-9]{11}|[0-9]{14})$",
              "description": "Dado restrito em texto."
            },
            "titularidade_cartao": {
              "enum": [
                "titular",
                "adicional"
              ]
            },
            "moeda": {
              "bsonType": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "status": {
              "enum": [
                "ativo",
                "encerrado",
                "desconhecido"
              ]
            },
            "source_record_ids": {
              "bsonType": "array",
              "uniqueItems": true,
              "items": {
                "bsonType": "objectId"
              }
            }
          }
        }
      }
    },
    "transactions": {
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "additionalProperties": false,
          "required": [
            "_id",
            "external_key",
            "schema_version",
            "account_id",
            "data_evento",
            "competencia",
            "valor",
            "moeda",
            "fluxo",
            "tipo",
            "descricao_original",
            "categoria",
            "localidade_contexto",
            "localidade_real_validada",
            "origem_localidade",
            "source",
            "status_conciliacao",
            "created_at",
            "updated_at"
          ],
          "properties": {
            "_id": {
              "bsonType": "objectId",
              "description": "Identificador MongoDB."
            },
            "external_key": {
              "bsonType": "string",
              "minLength": 1,
              "description": "Chave determinística para idempotência."
            },
            "schema_version": {
              "bsonType": "int",
              "minimum": 1,
              "description": "Versão do contrato."
            },
            "created_at": {
              "bsonType": "date",
              "description": "Data de criação técnica."
            },
            "updated_at": {
              "bsonType": "date",
              "description": "Última atualização técnica."
            },
            "status_revisao": {
              "enum": [
                "pendente",
                "validado"
              ],
              "description": "Estado da revisão humana; ausência equivale a pendente. Independente da conciliação."
            },
            "editado_em": {
              "bsonType": "date",
              "description": "Última edição manual direta da classificação."
            },
            "revisado_em": {
              "bsonType": "date",
              "description": "Data da validação humana explícita."
            },
            "account_id": {
              "bsonType": "objectId"
            },
            "data_evento": {
              "bsonType": "date"
            },
            "data_lancamento": {
              "bsonType": "date"
            },
            "competencia": {
              "bsonType": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            "valor": {
              "bsonType": "decimal",
              "description": "Valor assinado: negativo saída, positivo entrada."
            },
            "moeda": {
              "bsonType": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "fluxo": {
              "enum": [
                "entrada",
                "saida"
              ]
            },
            "tipo": {
              "enum": [
                "compra",
                "pix",
                "transferencia",
                "pagamento",
                "receita",
                "estorno",
                "tarifa",
                "juros",
                "multa",
                "imposto",
                "rendimento",
                "aplicacao",
                "resgate",
                "amortizacao",
                "seguro"
              ]
            },
            "natureza": {
              "enum": [
                "COMPRA",
                "IMPOSTO_TRIBUTO",
                "TARIFA_ENCARGO",
                "ESTORNO",
                "RENDIMENTO",
                "TRANSFERENCIA"
              ],
              "description": "Natureza econômica transversal. Não substitui o tipo operacional legado."
            },
            "descricao_original": {
              "bsonType": "string",
              "minLength": 1
            },
            "estabelecimento_original": {
              "bsonType": "string"
            },
            "merchant_id": {
              "bsonType": "objectId",
              "description": "Vendedor final canônico usado na análise; exibido como Vendedor na revisão."
            },
            "platform_id": {
              "bsonType": "objectId",
              "description": "Plataforma ou intermediador comercial, como iFood, 99Food, Rappi, Mercado Pago, Vindi, Alipay, Cappta, Google Play, Mercado Livre ou Crownbill, separado do Vendedor final."
            },
            "merchant_location_id": {
              "bsonType": "objectId",
              "description": "Filial/unidade específica confirmada para a transação."
            },
            "operator_entity_id": {
              "bsonType": "objectId",
              "description": "Empresa jurídica que operava a filial na data do evento, quando conhecida."
            },
            "categoria": {
              "bsonType": "string",
              "minLength": 1
            },
            "subcategoria": {
              "bsonType": "string"
            },
            "localidade": {
              "bsonType": "string",
              "description": "Local físico da compra presencial, quando conhecido."
            },
            "localidade_fornecedor": {
              "bsonType": "string",
              "description": "Localidade do fornecedor em compras online; não representa presença física do comprador."
            },
            "localidade_descritor": {
              "bsonType": "string",
              "description": "Cidade exatamente como recebida da fonte/fatura, mesmo quando pertence ao intermediador."
            },
            "localidade_contexto": {
              "enum": [
                "compra_presencial",
                "fornecedor_online",
                "nao_determinado"
              ]
            },
            "localidade_real_validada": {
              "bsonType": "bool",
              "description": "True somente quando a localidade analítica foi confirmada manualmente ou por evidência independente."
            },
            "origem_localidade": {
              "enum": [
                "confirmacao_manual",
                "regra_estabelecimento",
                "descritor_fatura",
                "intermediador_processador",
                "nao_informada"
              ]
            },
            "metodo_pagamento": {
              "enum": [
                "cartao_credito",
                "cartao_debito",
                "pix",
                "conta_corrente",
                "debito_conta",
                "transferencia",
                "dinheiro",
                "boleto",
                "sem_parar",
                "outro",
                "desconhecido"
              ]
            },
            "bill_id": {
              "bsonType": "objectId"
            },
            "installment": {
              "bsonType": "object",
              "additionalProperties": false,
              "required": [
                "numero",
                "total"
              ],
              "properties": {
                "plan_id": {
                  "bsonType": "objectId"
                },
                "numero": {
                  "bsonType": "int",
                  "minimum": 1
                },
                "total": {
                  "bsonType": "int",
                  "minimum": 1
                }
              }
            },
            "foreign_amount": {
              "bsonType": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "currency",
                "fx_rate_to_brl"
              ],
              "properties": {
                "value": {
                  "bsonType": "decimal",
                  "minimum": 0
                },
                "currency": {
                  "enum": [
                    "USD"
                  ]
                },
                "fx_rate_to_brl": {
                  "bsonType": "decimal",
                  "minimum": 0,
                  "exclusiveMinimum": true
                }
              }
            },
            "balance_after": {
              "bsonType": "decimal"
            },
            "purchase_channel": {
              "enum": [
                "presencial_ou_nao_informado",
                "web_app",
                "carteira_digital",
                "pix"
              ]
            },
            "purchase_origin": {
              "enum": [
                "nacional",
                "internacional"
              ]
            },
            "detalhe": {
              "bsonType": "string"
            },
            "recorrencia": {
              "bsonType": "object",
              "additionalProperties": false,
              "required": [
                "tipo",
                "periodicidade"
              ],
              "properties": {
                "tipo": {
                  "enum": [
                    "recorrente_fixa",
                    "recorrente_variavel",
                    "eventual"
                  ]
                },
                "periodicidade": {
                  "enum": [
                    "semanal",
                    "mensal",
                    "trimestral",
                    "semestral",
                    "anual",
                    "irregular",
                    "nao_aplicavel"
                  ]
                },
                "obligation_id": {
                  "bsonType": "objectId"
                },
                "source": {
                  "enum": [
                    "mobile_manual_review",
                    "reviewed_exact_match",
                    "reviewed_high_confidence_match",
                    "obligation",
                    "derived"
                  ]
                }
              }
            },
            "classification": {
              "bsonType": "object",
              "additionalProperties": false,
              "properties": {
                "source_category": {
                  "bsonType": "string"
                },
                "previous_category": {
                  "bsonType": "string"
                },
                "category_rule": {
                  "bsonType": "string"
                },
                "source_location": {
                  "bsonType": "string"
                },
                "location_rule": {
                  "bsonType": "string"
                },
                "migration_reason": {
                  "bsonType": "string"
                },
                "version": {
                  "bsonType": "string"
                }
              }
            },
            "source": {
              "bsonType": "object",
              "additionalProperties": false,
              "required": [
                "source_record_id",
                "identificador_original",
                "fonte"
              ],
              "properties": {
                "source_record_id": {
                  "bsonType": "objectId"
                },
                "identificador_original": {
                  "bsonType": "string",
                  "minLength": 1
                },
                "arquivo": {
                  "bsonType": "string"
                },
                "fonte": {
                  "bsonType": "string",
                  "minLength": 1
                },
                "legacy_dataset": {
                  "bsonType": "string"
                },
                "numero_documento": {
                  "bsonType": "string"
                }
              }
            },
            "status_conciliacao": {
              "enum": [
                "confirmado",
                "provavel",
                "pendente",
                "nao_aplicavel",
                "rejeitado"
              ]
            }
          }
        }
      }
    },
