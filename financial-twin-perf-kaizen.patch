+                    "schema_version": 2,
+                    "tipo_entidade": "marca",
+                    "nome_padrao": "Lanche Bem",
+                    "aliases": [{"valor": "LANCHE BEM", "normalizado": "LANCHE BEM", "status": "confirmado", "source_record_ids": []}],
