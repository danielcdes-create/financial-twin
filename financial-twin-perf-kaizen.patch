+                    "status": "provisional",
+                    "revision": 1,
+                    "merchant_raw": "CAPPTA LANCHE BEM FILIAL 2",
+                    "valor": Decimal128("-35.90"),
+                    "fluxo": "saida",
+                    "tipo": "compra",
+                    "natureza": "COMPRA",
+                    "categoria_sugerida": "Alimentação",
+                    "subcategoria": "Padaria",
+                    "metodo_pagamento": "cartao_credito",
+                    "data_evento": stamp,
