# Template only: fill on the server; never publish credentials.
ENVIRONMENT=production
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=

# Preserve the current MongoDB database and identity during migration.
MONGODB_URI=
MONGODB_DATABASE=financas
MONGODB_DIRECT_HOSTS=
MONGODB_REPLICA_SET=

# Preserve the existing server secret to keep current sessions verifiable.
# Must contain at least 32 characters. Do not put it in this template.
JWT_SECRET=
API_SECRET=
APP_PASSWORD=
ACCOUNT_SETUP_TOKEN=

# Copy the current server-side settings privately.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_TEXT_MODEL=grok-4.3
XAI_VISION_MODEL=grok-4.3
XAI_IMAGE_MODEL=grok-imagine-image
XAI_TRANSCRIPTION_MODEL=grok-voice-transcribe-2.0

MEDIA_STORAGE_PATH=/var/lib/financial-twin/media
ANDROID_APK_PATH=/var/lib/financial-twin/artifacts/financial-twin-arm64.apk
